{
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "0 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/library",
      "destination": "/prompts",
      "permanent": true
    },
    {
      "source": "/library/:path*",
      "destination": "/prompts/:path*",
      "permanent": true
    }
  ]
}
