# Variables de entorno de ARTO Studio AI.
# Copia este archivo a .env.local para desarrollo. Los valores reales de producción viven en Vercel;
# nunca se pegan aquí ni en el chat. Una línea por variable que el código lee (grep process.env en src).

# --- Supabase (Postgres, auth y storage) ---
# URL pública del proyecto Supabase; la usan el cliente del navegador y el servidor
NEXT_PUBLIC_SUPABASE_URL=
# Anon key pública de Supabase; desde el 2026-09-10 las tablas tienen RLS y la anon key no lee nada
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role de Supabase; la usa createAdminClient() en el servidor y salta RLS
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres (rol postgres) para postgres-js: trazas, waitlist y migraciones
DATABASE_URL=

# --- Anthropic ---
# API key de Anthropic; sin ella los skills caen al fallback determinista
ANTHROPIC_API_KEY=
# Modelo de Claude; en producción es claude-sonnet-5 desde el 2026-09-10 (decisión B de Victor)
ANTHROPIC_MODEL=

# --- OpenAI ---
# API key de OpenAI; embeddings de la búsqueda semántica y generación de imágenes (gpt-image-1)
OPENAI_API_KEY=

# --- Stripe (cobro) ---
# Secret key de Stripe; sk_test_ en local, sk_live_ solo en producción
STRIPE_SECRET_KEY=
# Publishable key de Stripe
STRIPE_PUBLISHABLE_KEY=
# Secreto de firma del webhook; se genera en el tablero de Stripe al dar de alta el endpoint
STRIPE_WEBHOOK_SECRET=
# Price ID del plan Starter
STRIPE_PRICE_ID_STARTER=
# Price ID del plan Pro
STRIPE_PRICE_ID_PRO=

# --- Email (Resend) ---
# API key de Resend; la usan el digest semanal y los correos transaccionales
RESEND_API_KEY=
# Remitente de los correos transaccionales, formato "Nombre <correo@dominio>"; la crea Victor (D5)
EMAIL_FROM=
# Id de la audiencia (segment) de Resend donde se dan de alta signups y correos del roast; sin ella no se sincroniza nada (Fase 1C). La crea Victor
RESEND_AUDIENCE_ID=

# --- Admin y seguridad ---
# API key del admin para endpoints protegidos (/api/traces, /admin); token largo aleatorio
ADMIN_API_KEY=
# Correos con acceso a /admin separados por coma; los compara isAdminEmail()
ADMIN_EMAILS=
# Sal para hashear las API keys de clientes; obligatoria en producción (el código trae un default de desarrollo)
ARTO_API_KEY_SALT=
# Secreto que Vercel manda como Bearer al cron /api/cron/digest; se crea en Vercel el 2026-09-11 (D5)
CRON_SECRET=

# --- Content Factory ---
# Token de Buffer para publicar posts sociales desde /admin/content
BUFFER_TOKEN=
# URL del servicio de imágenes (Higgsfield) para portadas de contenido; opcional
ARTO_IMAGE_SERVICE_URL=
# Secreto compartido con el servicio de imágenes; opcional
ARTO_IMAGE_SHARED_SECRET=

# --- Sitio y analítica ---
# URL canónica del sitio; en producción https://creative.artostudio.ai (D6)
NEXT_PUBLIC_SITE_URL=
# Project API key de PostHog para analítica de producto; la crea Victor (D5)
NEXT_PUBLIC_POSTHOG_KEY=
# Host de PostHog, por ejemplo https://us.i.posthog.com; la crea Victor (D5)
NEXT_PUBLIC_POSTHOG_HOST=
# Lo pone Next.js (development | production | test); no hace falta definirla a mano
NODE_ENV=
